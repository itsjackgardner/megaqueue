# MegaQueue configuration

# Host paths (used by docker-compose for volume mounts)
HOST_DOWNLOAD_DIR=/mnt/external/downloads
HOST_PLEX_MOVIES_DIR=/mnt/external/media/Movies
HOST_PLEX_TV_DIR=/mnt/external/media/TV Shows

# App config (all MEGAQUEUE_ vars are passed into the container via env_file)
MEGAQUEUE_SECRET_KEY=change-me-to-a-random-string
MEGAQUEUE_DOWNLOAD_DIR=/data/downloads
MEGAQUEUE_PLEX_MOVIES_DIR=/media/movies
MEGAQUEUE_PLEX_TV_DIR=/media/tv
MEGAQUEUE_DATABASE_URL=sqlite:////app/data/megaqueue.db
MEGAQUEUE_NTFY_TOPIC=megaqueue

# Optional
# MEGAQUEUE_NTFY_SERVER=https://ntfy.sh
# MEGAQUEUE_NTFY_ICON_URL=https://example.com/icon.png
# MEGAQUEUE_POLL_INTERVAL=5
# MEGAQUEUE_GRACE_PERIOD=30
# MEGAQUEUE_DOWNLOAD_WORKERS=8
# MEGAQUEUE_PROXY_FILE=/data/proxies.txt
